{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "instructions": [".opencode/rules/vision.md"],
  "provider": {
    "opencode": {
      "models": {
        "mimo-v2.5-free": {
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
